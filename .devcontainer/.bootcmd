echo "=== BEFORE ==="
ls -la .env openbot/.env 2>/dev/null
mv -f .env .env.root.bak 2>/dev/null && echo "root .env moved to .env.root.bak"
ls -la .env 2>/dev/null || echo "root .env gone"
echo "=== RESTART STACK ==="
pkill -f "scripts/start.sh" 2>/dev/null
sleep 1
( setsid bash scripts/start.sh >> _stack.log 2>&1 < /dev/null & )
echo relaunched