echo "=== OPENBOT ENV NOW ==="
grep -nE "PUBLIC_URL|APP_URL|TRUSTED|SINGLE" openbot/.env
echo "=== SERVER LOG TAIL ==="
tail -c 1200 openbot/.logs/server.log 2>/dev/null
echo ""
echo "=== STACK LOG TAIL ==="
tail -n 20 _stack.log 2>/dev/null
echo "=== LISTEN ==="
ss -tlnp 2>/dev/null | grep 3001 || echo NO_LISTEN